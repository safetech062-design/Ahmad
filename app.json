{
  "expo": {
    "name": "Mera Dost AI",
    "slug": "mera-dost-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05080F",
    "android": {
      "package": "com.meradost.ai",
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Mera Dost uses the microphone only when you tap the mic button."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Mera Dost looks up contacts only when you ask it to call or message someone."
        }
      ],
      "expo-notifications"
    ]
  }
}
